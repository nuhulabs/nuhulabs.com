pub fn Footer(ctx: *zx.ComponentCtx(struct {})) zx.Component {
    return (
        <footer @allocator={ctx.allocator} class="footer">
            <span class="footer-brand">Nuhu Labs</span>
            <div class="footer-links">
                <a href="mailto:hello@nuhulabs.com">hello@nuhulabs.com</a>
                <span class="footer-copy">© {2026}</span>
            </div>
        </footer>
    );
}

const zx = @import("zx");
