pub fn Layout(ctx: zx.LayoutContext, children: zx.Component) zx.Component {
    return (
        <html @allocator={ctx.arena} lang="en">
            <head>
                <meta charset="UTF-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1.0" />
                <meta
                    name="description"
                    content="Nuhu Labs is a product studio building high-quality software that scales, stays maintainable, and brings peace of mind."
                />
                <meta name="theme-color" content="#6EE7B7" />
                <title>Nuhu Labs</title>
                <link rel="icon" href="/favicon.ico" sizes="any" />
                <link rel="icon" type="image/png" href="/favicon.png" />
                <link rel="stylesheet" href="/assets/style.css" />
            </head>

            <body>
                <div class="grain" aria-hidden="true"></div>
                <div class="glow glow-a" aria-hidden="true"></div>
                <div class="glow glow-b" aria-hidden="true"></div>
                {children}
            </body>
        </html>
    );
}

const zx = @import("zx");
